# Example container env for wal-g wal-receive (single-tenant).
# Maps 1:1 to a K8s Pod spec via envFrom: configMapRef + secretRef.
#
# Usage:
#   cp .env.example .env
#   # ...edit values for your cluster...
#   docker run --env-file .env \
#     -v /path/to/tls:/etc/walg/tls:ro \
#     -v /path/to/ssh:/etc/walg/ssh:ro \
#     -v walg-partials:/var/lib/walg/partials \
#     --name wal-receive \
#     wal-g-receive:dev

# --- Primary connection ---
WALG_PRIMARY_HOST=primary.example.com
WALG_PRIMARY_PORT=5432
WALG_PRIMARY_USER=ubi_replication
WALG_PRIMARY_DB=postgres
WALG_APPLICATION_NAME=walg_sync

# --- Replication slot ---
WALG_SLOT_NAME=walg_sync

# --- Tenant identity ---
WALG_TENANT_NAME=async-ha-demo

# --- Standby push target (primary-loss path) ---
WALG_STANDBY_SSH_HOST=standby.example.com
WALG_STANDBY_SSH_USER=ubi
WALG_STANDBY_TARGET_DIR=/var/lib/postgresql/walg-tail
WALG_REMOTE_WALG_PATH=/usr/bin/wal-g

# --- Local storage ---
WALG_PARTIAL_DIR=/var/lib/walg/partials

# --- Tuning ---
WALG_WAL_RECEIVE_DRAIN_BATCHING=true
WALG_WAL_RECEIVE_SKIP_UPLOAD=true
WALG_WAL_RECEIVE_JANITOR_INTERVAL_SECONDS=30
WALG_LOG_LEVEL=NORMAL
